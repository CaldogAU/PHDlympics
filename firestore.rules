rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isRootAdministrator() {
      return isSignedIn()
        && (
          request.auth.uid == "prUrxokN7YQbloBefGQHMTQEPjJ3"
          || request.auth.token.tournamentRole == "administrator"
        );
    }

    function isManagedStaff() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/staff/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/staff/$(request.auth.uid)
        ).data.active == true
        && get(
          /databases/$(database)/documents/staff/$(request.auth.uid)
        ).data.role == "tournament-director";
    }

    function isTournamentManager() {
      return isRootAdministrator()
        || isManagedStaff()
        || (
          isSignedIn()
          && request.auth.token.tournamentRole == "tournament-director"
        );
    }

    function isTournamentOperator() {
      return isSignedIn() && (
        isTournamentManager()
        || request.auth.token.tournamentRole == "score-entry"
      );
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update: if isTournamentOperator();
      allow delete: if isRootAdministrator();
    }

    match /backups/{backupId} {
      allow read, create, update, delete: if isTournamentManager();
    }

    match /auditLogs/{auditId} {
      allow read: if isTournamentManager();

      allow create: if isTournamentManager()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && request.resource.data.tournamentDocument == "current";

      allow update, delete: if false;
    }

    match /staff/{staffId} {
      allow read: if isRootAdministrator()
        || isManagedStaff()
        || (
          isSignedIn()
          && request.auth.uid == staffId
        );

      allow create, update: if isTournamentManager()
        && request.resource.data.email is string
        && request.resource.data.role == "tournament-director"
        && request.resource.data.active is bool;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
